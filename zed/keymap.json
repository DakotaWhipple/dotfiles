// Zed keymap — LazyVim-flavored. Space leader, mirrors ~/.config/nvim.
// Core vim motions (gd, K, ciw, /, n, etc.) come from Zed's built-in vim mode.
[
  // ── Normal/visual leader bindings (space = leader) ──────────────────
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      // find / search (LazyVim <leader>f*, <leader>/, <leader>,)
      "space space": "file_finder::Toggle",
      "space f f": "file_finder::Toggle",
      "space f r": "projects::OpenRecent",
      "space f n": "workspace::NewFile",
      "space /": "workspace::NewSearch",
      "space ,": "tab_switcher::Toggle",
      "space :": "command_palette::Toggle",
      "space s s": "outline::Toggle",
      "space s d": "diagnostics::Deploy",

      // explorer (LazyVim <leader>e)
      "space e": "project_panel::ToggleFocus",
      "space b e": "workspace::ToggleLeftDock",

      // buffers (LazyVim <leader>b*, shift-h/l)
      "space b d": "pane::CloseActiveItem",
      "space b o": "pane::CloseInactiveItems",
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",
      "space `": "pane::ActivateLastItem",

      // code / lsp (LazyVim <leader>c*)
      "space c a": "editor::ToggleCodeActions",
      "space c r": "editor::Rename",
      "space c f": "editor::Format",
      "space c d": "editor::Hover",
      "space c s": "outline::Toggle",
      "g r": "editor::FindAllReferences",
      "g shift-d": "editor::GoToTypeDefinition",

      // diagnostics nav (LazyVim ]d / [d)
      "] d": ["editor::GoToDiagnostic", { "severity": { "min": "warning", "max": "error" } }],
      "[ d": ["editor::GoToPreviousDiagnostic", { "severity": { "min": "warning", "max": "error" } }],

      // git hunks (LazyVim ]h / [h)
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",
      "space g g": "git_panel::ToggleFocus",
      "space g d": "git::Diff",

      // windows / splits (LazyVim <leader>w*, ctrl-hjkl)
      "space w v": "pane::SplitRight",
      "space w s": "pane::SplitDown",
      "space w d": "pane::CloseActiveItem",
      "space w q": "pane::CloseActiveItem",
      "ctrl-h": ["workspace::ActivatePaneInDirection", "Left"],
      "ctrl-l": ["workspace::ActivatePaneInDirection", "Right"],
      "ctrl-j": ["workspace::ActivatePaneInDirection", "Down"],
      "ctrl-k": ["workspace::ActivatePaneInDirection", "Up"],

      // quit / write (LazyVim <leader>q*, ctrl-s)
      "space q q": "zed::Quit",
      "ctrl-s": "workspace::Save",

      // centered half-page scroll (your keymaps.lua C-d/C-u + zz)
      "ctrl-d": ["workspace::SendKeystrokes", "ctrl-d z z"],
      "ctrl-u": ["workspace::SendKeystrokes", "ctrl-u z z"],

      // clear search highlight (LazyVim <leader>ur). plain <esc> also clears it.
      "space u r": ["workspace::SendKeystrokes", ": n o h l enter"]
    }
  },

  // ── File-tree (project panel) vim-ish nav ───────────────────────────
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "x": "project_panel::Cut",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      "q": "workspace::ToggleLeftDock",
      "space e": "project_panel::ToggleFocus"
    }
  }
]
