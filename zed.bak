// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "colorize_brackets": true,
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "bypassPermissions",
      },
      "type": "registry",
    },
  },
  "base_keymap": "VSCode",
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "scroll_beyond_last_line": "one_page",
  "vertical_scroll_margin": 8,
  "cursor_blink": false,
  "vim": {
    "use_system_clipboard": "never",
    "use_multiline_find": true,
    "use_smartcase_find": true,
    "highlight_on_yank_duration": 200,
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
  "theme_overrides": {
    "Ayu Dark": {
      "syntax": {
        "attribute": { "color": "#FF944Dff" },
        "boolean": { "color": "#B170FFff" },
        "comment": { "color": "#B170FFff" },
        "comment.doc": { "color": "#BDC1C6ff" },
        "constant": { "color": "#B170FFff" },
        "constructor": { "color": "#FF944Dff" },
        "embedded": { "color": "#E8EAEDff" },
        "emphasis": { "color": "#B170FFff" },
        "emphasis.strong": { "color": "#B170FFff", "font_weight": 700 },
        "enum": { "color": "#FF944Dff" },
        "function": { "color": "#FFD13Bff" },
        "hint": { "color": "#9AA0A6ff" },
        "keyword": { "color": "#F15C52ff" },
        "label": { "color": "#FF944Dff" },
        "link_text": { "color": "#5494FEff", "font_style": "italic" },
        "link_uri": { "color": "#41CD7Dff" },
        "namespace": { "color": "#5494FEff" },
        "number": { "color": "#FF944Dff" },
        "operator": { "color": "#FF73B9ff" },
        "predictive": { "color": "#9AA0A6ff", "font_style": "italic" },
        "preproc": { "color": "#4DD0E1ff" },
        "primary": { "color": "#E8EAEDff" },
        "property": { "color": "#F15C52ff" },
        "punctuation": { "color": "#E8EAEDff" },
        "punctuation.bracket": { "color": "#E8EAEDff" },
        "punctuation.delimiter": { "color": "#E8EAEDff" },
        "punctuation.list_marker": { "color": "#E8EAEDff" },
        "punctuation.markup": { "color": "#E8EAEDff" },
        "punctuation.special": { "color": "#FF73B9ff" },
        "selector": { "color": "#5494FEff" },
        "selector.pseudo": { "color": "#F15C52ff" },
        "string": { "color": "#41CD7Dff" },
        "string.escape": { "color": "#FF73B9ff" },
        "string.regex": { "color": "#FF73B9ff" },
        "string.special": { "color": "#FF73B9ff" },
        "string.special.symbol": { "color": "#FF73B9ff" },
        "tag": { "color": "#5494FEff" },
        "text.literal": { "color": "#FF944Dff" },
        "title": { "color": "#E8EAEDff", "font_weight": 700 },
        "type": { "color": "#5494FEff" },
        "variable": { "color": "#F15C52ff" },
        "variant": { "color": "#5494FEff" },
        "diff.plus": { "color": "#41CD7Dff" },
        "diff.minus": { "color": "#F15C52ff" },
      },
    },
  },
}

