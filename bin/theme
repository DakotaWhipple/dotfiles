#!/usr/bin/env bash
# theme — switch the whole desktop vibe in one shot.
#
#   theme              list vibes (current one marked)
#   theme set <vibe>   apply a vibe: kitty, neovim (live), sketchybar,
#                      borders, starship, fzf, yazi, wallpaper
#   theme current      print the active vibe
#
# A vibe is a directory in ~/dotfiles/themes/<name> containing colors.sh.
set -uo pipefail

DOTS="${DOTFILES:-$HOME/dotfiles}"
THEMES_DIR="$DOTS/themes"
STATE="$HOME/.config/theme"

list_themes() {
  local cur=""
  [ -f "$STATE/current" ] && cur=$(<"$STATE/current")
  for d in "$THEMES_DIR"/*/; do
    local name desc
    name=$(basename "$d")
    desc=$(sed -n '2s/^# *//p' "$d/colors.sh")
    if [ "$name" = "$cur" ]; then
      printf "  \033[1;32m●\033[0m %-8s %s\n" "$name" "$desc"
    else
      printf "    %-8s %s\n" "$name" "$desc"
    fi
  done
}

gen_kitty_colors() { # palette vars are in scope
  cat <<EOF
# generated by theme(1) — vibe: $THEME_NAME
foreground            #$FG
background            #$BG
selection_foreground  #$FG
selection_background  #$BG_HL
cursor                #$FG
cursor_text_color     #$BG
url_color             #$ACCENT_ALT
active_border_color   #$ACCENT
inactive_border_color #$BG_HL
bell_border_color     #$YELLOW

active_tab_foreground   #$BG
active_tab_background   #$ACCENT
inactive_tab_foreground #$FG_MUTED
inactive_tab_background #$BG_DARK
tab_bar_background      #$BG_DARK

color0  #$BLACK
color8  #$BRIGHT_BLACK
color1  #$RED
color9  #$BRIGHT_RED
color2  #$GREEN
color10 #$BRIGHT_GREEN
color3  #$YELLOW
color11 #$BRIGHT_YELLOW
color4  #$BLUE
color12 #$BRIGHT_BLUE
color5  #$MAGENTA
color13 #$BRIGHT_MAGENTA
color6  #$CYAN
color14 #$BRIGHT_CYAN
color7  #$WHITE
color15 #$BRIGHT_WHITE
EOF
}

set_theme() {
  local name="$1" dir="$THEMES_DIR/$1"
  if [ ! -f "$dir/colors.sh" ]; then
    echo "theme: no such vibe '$name'" >&2
    list_themes
    exit 1
  fi

  # shellcheck source=/dev/null
  source "$dir/colors.sh"
  mkdir -p "$STATE"
  echo "$name" > "$STATE/current"
  ln -sf "$dir/colors.sh" "$STATE/colors.sh"

  ## kitty — regenerate include file, then live-update every running instance
  gen_kitty_colors > "$HOME/.config/kitty/current-theme.conf"
  for sock in /tmp/kitty-*; do
    [ -S "$sock" ] || continue
    kitten @ --to "unix:$sock" set-colors --all --configured \
      "$HOME/.config/kitty/current-theme.conf" 2>/dev/null
  done

  ## neovim — state file for new instances, RPC for running ones
  echo "$NVIM_COLORSCHEME" > "$STATE/nvim"
  for sock in "$HOME/.cache/nvim/theme-servers"/*.sock; do
    [ -S "$sock" ] || { rm -f "$sock" 2>/dev/null; continue; }
    nvim --server "$sock" \
      --remote-send "<Cmd>colorscheme $NVIM_COLORSCHEME<CR>" 2>/dev/null \
      || rm -f "$sock"
  done

  ## fzf — sourced by zsh on shell startup
  cat > "$STATE/fzf.sh" <<EOF
export FZF_DEFAULT_OPTS="--color=bg+:#$BG_HL,bg:-1,fg:#$FG,fg+:#$FG,hl:#$ACCENT,hl+:#$ACCENT,info:#$FG_MUTED,prompt:#$ACCENT,pointer:#$ACCENT_ALT,marker:#$GREEN,spinner:#$ACCENT,header:#$FG_MUTED,border:#$BG_HL --border=rounded"
EOF

  ## starship — flip the active palette
  sed -i '' "s/^palette = .*/palette = '$STARSHIP_PALETTE'/" "$DOTS/starship/starship.toml"

  ## yazi — partial theme overlay on its defaults
  cat > "$DOTS/yazi/theme.toml" <<EOF
# generated by theme(1) — vibe: $THEME_NAME
[mgr]
cwd = { fg = "#$ACCENT", bold = true }
hovered = { bg = "#$BG_HL" }
border_style = { fg = "#$ACCENT" }

[mode]
normal_main = { fg = "#$BG", bg = "#$ACCENT", bold = true }
select_main = { fg = "#$BG", bg = "#$ACCENT_ALT", bold = true }
unset_main  = { fg = "#$BG", bg = "#$RED", bold = true }
EOF

  ## sketchybar + borders — live refresh
  pgrep -xq sketchybar && sketchybar --reload
  pgrep -xq borders && borders active_color="0xff$ACCENT" inactive_color="0xcc$BG_HL" >/dev/null

  ## wallpaper — generate from palette if missing, then set
  local wp="$DOTS/wallpapers/$name.png"
  [ -f "$wp" ] || "$DOTS/bin/theme-wallpaper" "$name"
  if [ -f "$wp" ]; then
    osascript -e "tell application \"System Events\" to tell every desktop to set picture to \"$wp\"" >/dev/null
  fi

  printf "vibe set: \033[1m%s\033[0m (%s)\n" "$name" "$NVIM_COLORSCHEME"
}

case "${1:-list}" in
  list) list_themes ;;
  current) cat "$STATE/current" 2>/dev/null || echo "none" ;;
  set) [ $# -ge 2 ] || { echo "usage: theme set <vibe>" >&2; exit 1; }
       set_theme "$2" ;;
  *) # allow `theme forest` as shorthand for `theme set forest`
     if [ -f "$THEMES_DIR/$1/colors.sh" ]; then set_theme "$1"; else
       echo "usage: theme [list|current|set <vibe>]" >&2; exit 1
     fi ;;
esac
