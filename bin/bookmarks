#!/usr/bin/env python3
"""bookmarks — sync Chrome's bookmarks with the dotfiles repo.

  bookmarks save        snapshot Chrome's bookmarks -> chrome/bookmarks.json
  bookmarks restore     rebuild Chrome's bookmarks from chrome/bookmarks.json
  bookmarks path        print the Chrome Bookmarks file being read

Chrome is the source of truth. chrome/bookmarks.json is a clean, diff-friendly
mirror (folder / name / url tree only — no guids, ids or timestamps) kept in
source control. A launchd agent runs `bookmarks save` on a timer so the mirror
trails Chrome automatically; commit it whenever you like. `restore` rebuilds a
fresh machine's Chrome profile from the mirror (Chrome must be quit first).
"""

import json
import os
import subprocess
import sys
import time
import uuid

DOTS = os.environ.get("DOTFILES", os.path.expanduser("~/dotfiles"))
MIRROR = os.path.join(DOTS, "chrome", "bookmarks.json")
PROFILE = os.environ.get("CHROME_PROFILE", "Default")
CHROME_DIR = os.path.expanduser(
    f"~/Library/Application Support/Google/Chrome/{PROFILE}"
)
BOOKMARKS = os.path.join(CHROME_DIR, "Bookmarks")

# roots Chrome keeps; "synced" is owned by Chrome Sync, so we leave it alone.
ROOTS = ("bookmark_bar", "other")


def die(msg):
    sys.exit(f"bookmarks: {msg}")


# ---- save: Chrome -> clean mirror ---------------------------------------
def clean(node):
    """Reduce a Chrome bookmark node to name/url (or name/children)."""
    if node.get("type") == "url":
        return {"name": node["name"], "url": node["url"]}
    return {"name": node["name"], "children": [clean(c) for c in node.get("children", [])]}


def save():
    if not os.path.exists(BOOKMARKS):
        die(f"no Chrome bookmarks at {BOOKMARKS}")
    with open(BOOKMARKS, encoding="utf-8") as f:
        data = json.load(f)
    roots = data["roots"]
    mirror = {r: [clean(c) for c in roots[r].get("children", [])] for r in ROOTS}
    os.makedirs(os.path.dirname(MIRROR), exist_ok=True)
    with open(MIRROR, "w", encoding="utf-8") as f:
        json.dump(mirror, f, indent=2, ensure_ascii=False)
        f.write("\n")
    n = sum(_count(v) for v in mirror.values())
    print(f"saved {n} bookmarks -> {os.path.relpath(MIRROR, DOTS)}")


def _count(nodes):
    return sum(1 if "url" in x else _count(x["children"]) for x in nodes)


# ---- restore: clean mirror -> Chrome ------------------------------------
def webkit_now():
    # Chrome timestamps are microseconds since 1601-01-01.
    return str(int((time.time() + 11644473600) * 1_000_000))


class IdGen:
    def __init__(self, start=1000):
        self.n = start

    def __call__(self):
        self.n += 1
        return str(self.n)


def build(node, ids, ts):
    base = {
        "id": ids(),
        "guid": str(uuid.uuid4()),
        "date_added": ts,
    }
    if "url" in node:
        return {**base, "type": "url", "name": node["name"], "url": node["url"],
                "date_last_used": "0"}
    return {**base, "type": "folder", "name": node["name"], "date_modified": "0",
            "children": [build(c, ids, ts) for c in node["children"]]}


def chrome_running():
    out = subprocess.run(["pgrep", "-x", "Google Chrome"],
                         capture_output=True, text=True)
    return out.returncode == 0


def restore():
    if not os.path.exists(MIRROR):
        die(f"no mirror at {MIRROR} — run `bookmarks save` first")
    if chrome_running():
        die("Chrome is running — quit it first (it overwrites Bookmarks on exit)")
    if not os.path.exists(BOOKMARKS):
        die(f"no Chrome profile at {CHROME_DIR}")

    with open(MIRROR, encoding="utf-8") as f:
        mirror = json.load(f)
    with open(BOOKMARKS, encoding="utf-8") as f:
        data = json.load(f)

    ids, ts = IdGen(), webkit_now()
    for r in ROOTS:
        if r not in mirror:
            continue
        # keep the root folder object (fixed guid/id) — replace its children only
        data["roots"][r]["children"] = [build(c, ids, ts) for c in mirror[r]]
    data.pop("checksum", None)  # Chrome recomputes on load

    backup = BOOKMARKS + ".bak." + time.strftime("%Y%m%d%H%M%S")
    os.replace(BOOKMARKS, backup)
    bak = BOOKMARKS + ".bak"  # Chrome's own rollback copy — drop the stale one
    if os.path.exists(bak):
        os.remove(bak)
    with open(BOOKMARKS, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False)
    n = sum(_count(mirror.get(r, [])) for r in ROOTS)
    print(f"restored {n} bookmarks -> {PROFILE} (old set: {os.path.basename(backup)})")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "save":
        save()
    elif cmd == "restore":
        restore()
    elif cmd == "path":
        print(BOOKMARKS)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
