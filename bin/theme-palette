def write_nvim(vibe, p):
    vals = dict(p)
    vals["vibe"] = vibe
    vals["DIFF_ADD"] = mix(p["BG"], p["GREEN"], 0.18)
    vals["DIFF_CHANGE"] = mix(p["BG"], p["BLUE"], 0.18)
    vals["DIFF_DELETE"] = mix(p["BG"], p["RED"], 0.18)
    vals["DIFF_TEXT"] = mix(p["BG"], p["BLUE"], 0.32)
    path = DOTS / "nvim" / "rice" / "colors" / f"rice-{vibe}.lua"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(NVIM_TEMPLATE.format(**vals))
    return path

def write_starship_palettes(all_palettes):
    """Regenerate every [palettes.<vibe>] block in starship.toml."""
    cfg = DOTS / "starship" / "starship.toml"
    text = cfg.read_text()
    m = re.search(r"^\[palettes\.", text, re.M)  # always the trailing section
    if m:
        text = text[:m.start()]
    text = text.rstrip() + "\n"
    
    full_palettes = {}
    for d in (DOTS / "themes").iterdir():
        cfile = d / "colors.sh"
        if cfile.is_file():
            p = {}
            for m_var in re.finditer(r'\b([A-Z_0-9]+)="([^"]+)"', cfile.read_text()):
                p[m_var.group(1)] = m_var.group(2)
            if "ACCENT" in p:
                full_palettes[d.name] = p
                
    for vibe, p in sorted(full_palettes.items()):
        text += (
            f"\n[palettes.{vibe}]\n"
            f"accent = '#{p['ACCENT']}'\naccent2 = '#{p['ACCENT_ALT']}'\n"
            f"muted = '#{p['FG_MUTED']}'\nred = '#{p['RED']}'\n"
            f"green = '#{p['GREEN']}'\nyellow = '#{p['YELLOW']}'\n"
            f"magenta = '#{p['MAGENTA']}'\ncyan = '#{p['CYAN']}'\n"
        )
    cfg.write_text(text)

def read_seed(vibe):
    """seed.sh is plain KEY="value" lines (shell-sourceable); PIN_X pins a hex."""
    seed, pin = {}, {}
    for line in (DOTS / "themes" / vibe / "seed.sh").read_text().splitlines():
        m = re.match(r'^([A-Z_0-9]+)="?([^"#]*)"?\s*(#.*)?$', line.strip())
        if not m:
            continue
        k, v = m.group(1), m.group(2).strip()
        if k.startswith("PIN_"):
            pin[k[4:]] = v.lower().lstrip("#")
        else:
            seed[k] = v
    seed["pin"] = pin
    return seed

def main(argv):
    vibes = argv or None
    if not vibes or vibes == ["--all"]:
        vibes = sorted(d.name for d in (DOTS / "themes").iterdir()
                       if (d / "seed.sh").is_file())
    all_p = {}
    for vibe in vibes:
        seed = read_seed(vibe)
        p = build(seed)
        all_p[vibe] = p
        write_colors_sh(vibe, seed, p)
        write_nvim(vibe, p)
        print(f"generated: {vibe}  bg=#{p['BG']} accent=#{p['ACCENT']} "
              f"border=#{p['BORDER_ACTIVE']} (contrast "
              f"{contrast(p['BORDER_ACTIVE'], p['BG']):.1f}:1 vs "
              f"{contrast(p['ACCENT'], p['BG']):.1f}:1 raw)")
    write_starship_palettes(all_p)
    print("starship palettes refreshed")

if __name__ == "__main__":
    main(sys.argv[1:])
