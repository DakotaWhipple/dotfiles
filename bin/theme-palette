#!/usr/bin/env python3
"""theme-palette — derive a full vibe palette from a small seed, perceptually.

    theme-palette <vibe>...     regenerate themes/<vibe>/colors.sh (+ nvim scheme)
    theme-palette --all         regenerate every vibe that has a seed.sh

Colors are built in OKLCH so every vibe shares the same perceptual structure:
uniform lightness/chroma across the ANSI row (nothing washed out, nothing neon
by accident), foreground pinned to a WCAG contrast target against the
background, and focus borders mixed toward the background so they signal focus
without a hard edge. A seed only states hues and a couple of mood multipliers;
the formula does the rest. Seeds may also pin exact hexes (cozy keeps stock
Catppuccin Mocha) — derived roles are still computed from the pinned values.

Outputs per vibe:
  themes/<vibe>/colors.sh        sourced by theme(1), borders, sketchybar
  nvim/rice/colors/rice-<vibe>.lua   generated colorscheme (IntelliJ-ish mapping)
Plus one shared block: the [palettes.*] section of starship/starship.toml.
"""

import math
import re
import sys
from pathlib import Path

DOTS = Path.home() / "dotfiles"

# ---------------------------------------------------------------- color math

def _cbrt(x):
    return math.copysign(abs(x) ** (1 / 3), x)

def srgb_to_oklch(hexstr):
    r, g, b = (int(hexstr[i:i + 2], 16) / 255 for i in (0, 2, 4))
    def lin(c):
        return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = lin(r), lin(g), lin(b)
    l = _cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b)
    m = _cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b)
    s = _cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b)
    L = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
    a = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s
    bb = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
    C = math.hypot(a, bb)
    H = math.degrees(math.atan2(bb, a)) % 360
    return L, C, H

def _oklch_to_linear(L, C, H):
    a = C * math.cos(math.radians(H))
    b = C * math.sin(math.radians(H))
    l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
    return (
        +4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
        -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
        -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s,
    )

def oklch(L, C, H):
    """OKLCH -> sRGB hex, reducing chroma to the gamut boundary if needed."""
    def in_gamut(c):
        return all(-1e-4 <= v <= 1 + 1e-4 for v in _oklch_to_linear(L, c, H))
    if not in_gamut(C):
        lo, hi = 0.0, C
        for _ in range(24):
            mid = (lo + hi) / 2
            if in_gamut(mid):
                lo = mid
            else:
                hi = mid
        C = lo
    rgb = _oklch_to_linear(L, C, H)
    def enc(c):
        c = min(1, max(0, c))
        c = 12.92 * c if c <= 0.0031308 else 1.055 * c ** (1 / 2.4) - 0.055
        return round(c * 255)
    return "%02x%02x%02x" % tuple(enc(c) for c in rgb)

def luminance(hexstr):
    def lin(c):
        c = int(c, 16) / 255
        return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = lin(hexstr[0:2]), lin(hexstr[2:4]), lin(hexstr[4:6])
    return 0.2126 * r + 0.7152 * g + 0.0722 * b

def contrast(a, b):
    la, lb = luminance(a), luminance(b)
    hi, lo = max(la, lb), min(la, lb)
    return (hi + 0.05) / (lo + 0.05)

def with_contrast(L, C, H, bg, target):
    """Raise lightness until oklch(L,C,H) hits the contrast target on bg."""
    for _ in range(40):
        hx = oklch(L, C, H)
        if contrast(hx, bg) >= target or L >= 0.98:
            return hx
        L += 0.01
    return hx

def mix(hex_a, hex_b, t):
    """Blend a toward b by t, in OKLCH (hue via shortest arc)."""
    La, Ca, Ha = srgb_to_oklch(hex_a)
    Lb, Cb, Hb = srgb_to_oklch(hex_b)
    d = (Hb - Ha + 180) % 360 - 180
    return oklch(La + (Lb - La) * t, Ca + (Cb - Ca) * t, (Ha + d * t) % 360)

def hue_toward(h, target, t):
    d = (target - h + 180) % 360 - 180
    return (h + d * t) % 360

# ---------------------------------------------------------------- the formula

# OKLCH hue anchors for the ANSI row; every vibe nudges these toward its own
# accent hue so the row feels related to the theme instead of stock-terminal.
ANSI_HUES = {"red": 22, "green": 145, "yellow": 95, "blue": 262,
             "magenta": 335, "cyan": 195}

def build(seed):
    p = {}
    pin = seed.get("pin", {})

    L_bg = float(seed.get("L_BG", 0.22))
    C_bg = float(seed.get("C_BG", 0.015))
    H_bg = float(seed.get("H_BG", 260))
    H_fg = float(seed.get("H_FG", H_bg))
    H_acc = float(seed.get("H_ACCENT", 260))
    H_alt = float(seed.get("H_ACCENT_ALT", (H_acc + 60) % 360))
    sat = float(seed.get("SAT", 1.0))          # accent/ansi chroma multiplier
    cohesion = float(seed.get("COHESION", 0.12))  # ansi hue pull toward accent

    def base(name, fallback):
        p[name] = pin.get(name, fallback)

    base("BG",      oklch(L_bg, C_bg, H_bg))
    base("BG_DARK", oklch(L_bg - 0.035, C_bg, H_bg))
    base("BG_HL",   oklch(L_bg + 0.075, C_bg + 0.008, H_bg))
    base("FG",      with_contrast(0.86, 0.022, H_fg, p["BG"], 9.0))
    base("FG_MUTED", with_contrast(0.66, 0.025, H_fg, p["BG"], 4.0))
    # chroma rides at the sRGB gamut's edge for the display; comfort comes from
    # the unchanged contrast targets (same lightness vs bg), not from greyness.
    base("ACCENT",     with_contrast(0.72, 0.165 * sat, H_acc, p["BG"], 4.5))
    base("ACCENT_ALT", with_contrast(0.71, 0.155 * sat, H_alt, p["BG"], 4.5))

    for name, hue in ANSI_HUES.items():
        h = hue_toward(hue, H_acc, cohesion)
        L = {"yellow": 0.83, "cyan": 0.78}.get(name, 0.73)
        c = 0.15 * sat
        base(name.upper(), with_contrast(L, c, h, p["BG"], 4.5))
        base("BRIGHT_" + name.upper(), oklch(min(0.95, L + 0.06), c + 0.01, h))

    base("BLACK", oklch(L_bg + 0.13, C_bg + 0.01, H_bg))
    base("BRIGHT_BLACK", oklch(L_bg + 0.24, C_bg + 0.01, H_bg))
    base("WHITE", mix(p["FG"], p["BG"], 0.12))
    base("BRIGHT_WHITE", with_contrast(0.92, 0.015, H_fg, p["BG"], 11.0))

    # focus border: clearly the accent, but pulled toward the background so the
    # window edge glows instead of cutting. ~3:1 on bg reads as "focused"
    # without the razor edge a raw accent has (often 7:1+).
    p["BORDER_ACTIVE"] = mix(p["ACCENT"], p["BG"], 0.40)
    if contrast(p["BORDER_ACTIVE"], p["BG"]) < 2.6:
        p["BORDER_ACTIVE"] = mix(p["ACCENT"], p["BG"], 0.25)
    p["BORDER_INACTIVE"] = mix(p["BG_HL"], p["BG"], 0.45)

    # syntax roles — IntelliJ New UI temperament: one warm pole (keywords),
    # one cool pole (functions), everything at near-uniform L and modest
    # chroma so code reads as prose with landmarks, not confetti.
    sl, sc = 0.78, 0.095 * sat
    p["SYN_KEYWORD"]  = with_contrast(sl, sc + 0.02, hue_toward(45, H_acc, 0.25), p["BG"], 4.5)
    p["SYN_FUNC"]     = with_contrast(sl, sc, hue_toward(245, H_acc, 0.20), p["BG"], 4.5)
    p["SYN_STRING"]   = with_contrast(sl - 0.04, sc, hue_toward(140, H_acc, 0.15), p["BG"], 4.5)
    p["SYN_NUMBER"]   = with_contrast(sl, sc, hue_toward(200, H_acc, 0.15), p["BG"], 4.5)
    p["SYN_TYPE"]     = with_contrast(sl + 0.04, sc - 0.02, hue_toward(90, H_acc, 0.20), p["BG"], 5.0)
    p["SYN_CONST"]    = with_contrast(sl, sc, hue_toward(310, H_acc, 0.20), p["BG"], 4.5)
    p["SYN_PROP"]     = mix(p["FG"], p["SYN_CONST"], 0.35)
    p["SYN_COMMENT"]  = with_contrast(0.58, 0.03, H_fg, p["BG"], 3.0)
    p["SYN_OPERATOR"] = mix(p["FG"], p["BG"], 0.18)
    p["SYN_SPECIAL"]  = p["ACCENT_ALT"]

    base("WALL0", oklch(max(0.10, L_bg - 0.07), C_bg, H_bg))
    base("WALL1", p["BG"])
    base("WALL2", mix(p["BG"], p["ACCENT"], 0.24))
    base("WALL3", mix(p["BG"], p["ACCENT_ALT"], 0.24))
    return p

# ---------------------------------------------------------------- file output

ORDER = ["BG", "BG_DARK", "BG_HL", "FG", "FG_MUTED", "ACCENT", "ACCENT_ALT"]
ANSI_ORDER = ["BLACK", "RED", "GREEN", "YELLOW", "BLUE", "MAGENTA", "CYAN", "WHITE"]
SYN_ORDER = ["SYN_KEYWORD", "SYN_FUNC", "SYN_STRING", "SYN_NUMBER", "SYN_TYPE",
             "SYN_CONST", "SYN_PROP", "SYN_COMMENT", "SYN_OPERATOR", "SYN_SPECIAL"]

def write_colors_sh(vibe, seed, p):
    out = [
        "#!/usr/bin/env bash",
        f"# {seed['DESC']}",
        "# GENERATED by theme-palette from seed.sh — edit the seed, not this.",
        f'THEME_NAME="{vibe}"',
        f'NVIM_COLORSCHEME="{seed["NVIM_COLORSCHEME"]}"',
        f'STARSHIP_PALETTE="{vibe}"',
        "",
    ]
    out += [f'{k}="{p[k]}"' for k in ORDER]
    out.append("")
    for name in ANSI_ORDER:
        out.append(f'{name}="{p[name]}"'.ljust(22) + f'BRIGHT_{name}="{p["BRIGHT_" + name]}"')
    out.append("")
    out.append("# derived roles: soft focus border + nvim syntax")
    out.append(f'BORDER_ACTIVE="{p["BORDER_ACTIVE"]}"   BORDER_INACTIVE="{p["BORDER_INACTIVE"]}"')
    out += [f'{k}="{p[k]}"' for k in SYN_ORDER]
    out.append("")
    out.append("# wallpaper gradient stops (dark -> tinted)")
    out.append(f'WALL0="{p["WALL0"]}"; WALL1="{p["WALL1"]}"; WALL2="{p["WALL2"]}"; WALL3="{p["WALL3"]}"')
    path = DOTS / "themes" / vibe / "colors.sh"
    path.write_text("\n".join(out) + "\n")
    return path

